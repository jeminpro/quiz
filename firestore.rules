rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    match /families/{uid} {
      allow read, write: if false;

      match /profiles/{profileId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && request.resource.data.id == profileId;
        allow update: if owns(uid) && request.resource.data.id == profileId;
        allow delete: if false;

        match /progress/{questionId} {
          allow read, write: if owns(uid);
        }

        match /attempts/{attemptId} {
          allow read: if owns(uid);
          allow create: if owns(uid)
            && request.resource.data.id == attemptId
            && request.resource.data.profileId == profileId
            && request.resource.data.status == 'saving';
          allow update: if owns(uid)
            && resource.data.status == 'saving'
            && (
              request.resource.data == resource.data
              || (request.resource.data.status == 'complete'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            );
          allow delete: if false;

          match /items/{itemId} {
            allow read, create: if owns(uid);
            allow update: if owns(uid) && request.resource.data == resource.data;
            allow delete: if false;
          }
        }
      }
    }
  }
}
