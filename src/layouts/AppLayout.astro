---
import '../styles/global.css';
const { title } = Astro.props;
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eff4e9" />
    <meta name="description" content="A family quiz app for broad, curious 11+ practice." />
    <title>{title} · Brightside Quiz</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={home}><span class="brand-icon">✦</span><span>Brightside<span class="brand-light"> Quiz</span></span></a>
        <nav id="nav" aria-label="Main navigation"></nav>
      </div>
    </header>
    <main class="shell" id="main">
      <div id="status" hidden role="alert"></div>
      <div id="app"><div class="loading">Loading your practice space…</div></div>
    </main>
    <footer class="site-footer shell">
      <span>Made for thoughtful practice.</span>
      <span>Independent FSCE-inspired questions · Not an official FSCE paper</span>
    </footer>
    <script>import '../lib/app';</script>
  </body>
</html>
